    "drizzle-orm": "^0.43.1",
    "hono": "^4.12.18",
    "openai": "^4.100.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.18",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
