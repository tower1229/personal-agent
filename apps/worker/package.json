{
  "name": "@personal-agent/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "scripts": {
    "dev": "npm run build -w @personal-agent/admin && wrangler dev --test-scheduled",
    "deploy": "npm run build -w @personal-agent/admin && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply personal-agent-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply personal-agent-db --remote",
    "prebuild": "npm run build -w @personal-agent/shared",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @personal-agent/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@personal-agent/shared": "*",
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.94.0"
  }
}
